{
  "name": "betterkugou",
  "private": true,
  "version": "1.0.1",
  "description": "BetterKuGou",
  "author": "鸢夏 <1925019494@qq.com>",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check.cjs",
    "build:audio-effects": "node scripts/build-audio-effects.cjs",
    "test": "node --test",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build && node scripts/build-distribution.cjs",
    "install-backend-deps": "cd KuGouMusicApi && npm install --omit=dev",
    "postinstall": "npm run install-backend-deps",
    "dist": "npm run electron:build --",
    "dist:win": "npm run build && node scripts/build-distribution.cjs --win",
    "dist:linux": "npm run build && node scripts/build-distribution.cjs --linux",
    "dist:mac": "npm run build && node scripts/build-distribution.cjs --mac",
    "build:win": "npm run dist:win --"
  },
  "build": {
    "beforePack": "scripts/prepare-audio-effects.cjs",
    "appId": "com.betterkugou.app",
    "productName": "BetterKuGou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/themes/**/*"
    ],
    "extraResources": [
      {
        "from": "native/audio-effects/package/${arch}",
        "to": "audio-effects"
      },
      {
        "from": "electron/services",
        "to": "audio-effects",
        "filter": [
          "audioEffectsWorker.cjs",
          "audioEffectsProtocol.cjs"
        ]
      },
      {
        "from": "electron/services",
        "to": "music-download",
        "filter": [
          "musicDownloadWorker.cjs",
          "musicTransfer.cjs"
        ]
      },
      {
        "from": "electron/services/playlistCacheWorker.cjs",
        "to": "playlist-cache/playlistCacheWorker.cjs"
      },
      {
        "from": "electron/services",
        "to": "updater",
        "filter": [
          "updateWorker.cjs",
          "updateAssets.cjs"
        ]
      },
      {
        "from": "KuGouMusicApi",
        "to": "backend",
        "filter": [
          "{app,index,main,server}.js",
          "package.json",
          "LICENSE",
          "module/*.js",
          "util/*.js",
          "util/config.json",
          "public/index.html",
          "node_modules/**/*",
          "!**/{.env,.env.*,.npmrc,.netrc,.git-credentials,*.pem,*.key,*.p12,*.pfx,*.log}"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": true,
      "target": "nsis",
      "icon": "public/logo.ico",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "publish": {
        "provider": "github",
        "owner": "FLC-Team",
        "repo": "BetterKuGou",
        "publishAutoUpdate": false
      },
      "icon": "public/logo.png",
      "category": "AudioVideo;Audio;Player",
      "maintainer": "鸢夏 <1925019494@qq.com>",
      "synopsis": "BetterKuGou music player",
      "description": "BetterKuGou 音乐播放器，提供音乐播放、同步歌词、歌单和个性化主题。",
      "desktop": {
        "Name": "BetterKuGou",
        "GenericName": "Music Player",
        "GenericName[zh_CN]": "音乐播放器",
        "Comment[zh_CN]": "音乐播放、同步歌词与个性化主题",
        "Keywords": "Music;Audio;Player;Lyrics;",
        "Keywords[zh_CN]": "音乐;播放器;歌词;歌单;",
        "StartupNotify": "true"
      }
    },
    "deb": {
      "afterRemove": "installer/linux-after-remove.tpl"
    },
    "rpm": {
      "afterRemove": "installer/linux-after-remove.tpl"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo.png"
    },
    "dmg": {
      "artifactName": "${productName}-v${version}-mac-${arch}.${ext}",
      "background": "installer/assets/dmg-background.png",
      "window": {
        "width": 640,
        "height": 420
      },
      "iconSize": 96,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 184,
          "y": 218,
          "type": "file"
        },
        {
          "x": 456,
          "y": 218,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "useZip": true,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": false,
      "include": "installer/windows.nsh",
      "installerLanguages": [
        "zh_CN"
      ],
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico",
      "artifactName": "${productName}-v${version}-win-${arch}-setup.${ext}"
    }
  },
  "dependencies": {
    "@fue/ui": "file:vendor/fue-ui-0.1.0-bk.1.tgz",
    "axios": "^1.7.9",
    "node-taglib-sharp": "6.0.3",
    "opencc-js": "1.4.2",
    "postcss": "8.5.6",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/compiler-sfc": "^3.5.12",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.28.7"
  }
}
