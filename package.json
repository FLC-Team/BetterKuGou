{
  "name": "betterkugou",
  "private": true,
  "version": "0.1.6-alpha-pre1",
  "description": "BetterKuGou",
  "author": "鸢夏 <1925019494@qq.com>",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check.cjs",
    "test": "node --test",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build && electron-builder",
    "install-backend-deps": "cd KuGouMusicApi && npm install --omit=dev",
    "postinstall": "npm run install-backend-deps",
    "dist": "npm run electron:build",
    "dist:win": "npm run build && electron-builder --win --x64 --ia32 --arm64",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.betterkugou.app",
    "productName": "BetterKuGou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/themes/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/services/updateWorker.cjs",
        "to": "updater/updateWorker.cjs"
      },
      {
        "from": "KuGouMusicApi",
        "to": "backend",
        "filter": [
          "**/*",
          "!docs{,/**/*}",
          "!.github{,/**/*}",
          "!*.md",
          "!Dockerfile",
          "!tsconfig.json",
          "!pnpm-lock.yaml"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32", "arm64"]
        }
      ],
      "icon": "public/logo.ico",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "public/logo.png",
      "category": "AudioVideo;Audio;Player",
      "maintainer": "鸢夏 <1925019494@qq.com>",
      "synopsis": "BetterKuGou music player",
      "description": "BetterKuGou 音乐播放器，提供音乐播放、同步歌词、歌单和个性化主题。",
      "desktop": {
        "Name": "BetterKuGou",
        "GenericName": "Music Player",
        "GenericName[zh_CN]": "音乐播放器",
        "Comment[zh_CN]": "音乐播放、同步歌词与个性化主题",
        "Keywords": "Music;Audio;Player;Lyrics;",
        "Keywords[zh_CN]": "音乐;播放器;歌词;歌单;",
        "StartupNotify": "true"
      }
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/logo.png"
    },
    "dmg": {
      "background": "installer/assets/dmg-background.png",
      "window": {
        "width": 640,
        "height": 420
      },
      "iconSize": 96,
      "iconTextSize": 12,
      "contents": [
        { "x": 184, "y": 218, "type": "file" },
        { "x": 456, "y": 218, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "installer/windows.nsh",
      "installerLanguages": ["zh_CN"],
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico",
      "artifactName": "${productName}-v${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "postcss": "8.5.6",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/compiler-sfc": "^3.5.12",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.28.7"
  }
}
