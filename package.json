{
  "name": "betterkugou",
  "private": true,
  "version": "0.1.6-alpha-pre1",
  "description": "BetterKuGou",
  "author": "鸢夏 <1925019494@qq.com>",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "node scripts/check.cjs",
    "test": "node --test",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build && electron-builder",
    "install-backend-deps": "cd KuGouMusicApi && npm install --omit=dev",
    "postinstall": "npm run install-backend-deps",
    "dist": "npm run electron:build",
    "dist:win": "npm run build && electron-builder --win --x64 --ia32 --arm64",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.betterkugou.app",
    "productName": "BetterKuGou",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/themes/**/*"
    ],
    "extraResources": [
      {
        "from": "KuGouMusicApi",
        "to": "backend",
        "filter": [
          "**/*",
          "!docs{,/**/*}",
          "!.github{,/**/*}",
          "!*.md",
          "!Dockerfile",
          "!tsconfig.json",
          "!pnpm-lock.yaml"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32", "arm64"]
        }
      ],
      "icon": "public/logo.ico",
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "public/logo.png",
      "category": "AudioVideo",
      "maintainer": "鸢夏 <1925019494@qq.com>"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico",
      "license": "LICENSE",
      "artifactName": "${productName}-v${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/compiler-sfc": "^3.5.12",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.11",
    "vite-plugin-electron": "^0.28.7"
  }
}
